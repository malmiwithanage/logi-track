generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  VIEWER
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model Tenant {
  id            String         @id
  name          String
  slug          String         @unique
  createdAt     DateTime       @default(now())
  branches      Branch[]
  users         User[]
  shipmentTrips ShipmentTrip[]
  exportJobs     ExportJob[]
}

model Branch {
  id            String         @id
  name          String
  tenantId      String
  createdAt     DateTime       @default(now())
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users         User[]
  shipmentTrips ShipmentTrip[]
  exportJobs     ExportJob[]

  @@index([tenantId])
}

model User {
  id        String   @id
  email     String   @unique
  password  String
  role      UserRole
  tenantId  String
  branchId  String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  exportJobs ExportJob[]

  @@index([tenantId])
  @@index([branchId])
}

enum ExportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ExportJob {
  id            String         @id @default(uuid())
  status        ExportJobStatus @default(PENDING)
  tenantId      String
  branchId      String
  requestedById String
  fileUrl       String?
  rowCount      Int?
  error         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  completedAt   DateTime?
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  requestedBy   User           @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId, createdAt])
  @@index([requestedById])
}

model ShipmentTrip {
  id             String         @id @default(uuid())
  trackingNumber String         @unique
  distanceKm     Float
  fuelConsumedL  Float
  origin         String
  destination    String
  weightKg       Float
  status         ShipmentStatus
  tenantId       String
  branchId       String
  createdAt      DateTime       @default(now())
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([branchId, createdAt])
  @@index([status])
}
