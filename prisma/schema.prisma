generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MANAGER
}

enum ShipmentStatus {
  DELIVERED
}

model Tenant {
  id            String         @id
  name          String
  createdAt     DateTime       @default(now())
  branches      Branch[]
  users         User[]
  shipmentTrips ShipmentTrip[]
}

model Branch {
  id            String         @id
  name          String
  tenantId      String
  createdAt     DateTime       @default(now())
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users         User[]
  shipmentTrips ShipmentTrip[]

  @@index([tenantId])
}

model User {
  id        String   @id
  email     String   @unique
  password  String
  role      UserRole
  tenantId  String
  branchId  String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([branchId])
}

model ShipmentTrip {
  id             String         @id @default(uuid())
  trackingNumber String         @unique
  distanceKm     Float
  fuelConsumedL  Float
  status         ShipmentStatus
  tenantId       String
  branchId       String
  createdAt      DateTime       @default(now())
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([branchId, createdAt])
  @@index([status])
}
